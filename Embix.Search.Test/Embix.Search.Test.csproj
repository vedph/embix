		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Embix.Search.MySql\Embix.Search.MySql.csproj" />
		<ProjectReference Include="..\Embix.Search.PgSql\Embix.Search.PgSql.csproj" />
	</ItemGroup>

</Project>
